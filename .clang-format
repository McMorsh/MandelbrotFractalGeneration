BasedOnStyle: Google
Standard: c++20

# Сохраняем ручные группы include: own, standard, third-party, project
IncludeBlocks: Preserve
SortIncludes: CaseSensitive

# Отступы: Google-стиль, 2 пробела, без табов
IndentWidth: 2
UseTab: Never
TabWidth: 2
ColumnLimit: 80

# Содержимое namespace не сдвигается
NamespaceIndentation: None

# Спецификаторы доступа сдвигаются на один пробел
AccessModifierOffset: -1

# Указатели и ссылки: Type* name, Type& name
DerivePointerAlignment: false
PointerAlignment: Left

# Переносы и короткие конструкции оставляем на усмотрение clang-format
AllowShortFunctionsOnASingleLine: Empty
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortCaseLabelsOnASingleLine: false

# Максимальное количество пустых строк
MaxEmptyLinesToKeep: 1

# Комментарии переносятся по ширине строки
ReflowComments: true
